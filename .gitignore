CLAUDE.local.md

# Build output
/bin/
*.syso
/.task/

# Frontend
/frontend/node_modules/
/frontend/dist/*
!/frontend/dist/.gitkeep

# Throwaway UI option previews (see .claude/skills/ui-options)
/frontend/.preview/

# Wails-generated TypeScript bindings (regenerated by the build)
/frontend/bindings/

# Throwaway macOS icon written by `wails3 generate icons` on a Windows-only build
/build/darwin/icon.icns

# Online-only WebView2 bootstrapper, refetched by the packaging task
/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# Machine-local Claude config (names the reference repos, must stay uncommitted)
.claude/settings.local.json

# Kept locally for a future README preview, deliberately untracked
/images/league-rpc-gui-showcase.gif

# Internal working notes: tickets and specs stay local.
/.scratch/
